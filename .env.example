NODE_ENV=development
PORT=4000

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=serveaso1

# Postgres TLS (production / RDS). Bundled CA: certs/rds-global-bundle.pem
# POSTGRES_SSL_REJECT_UNAUTHORIZED=true   # default strict when CA bundle is present
# POSTGRES_SSL_REJECT_UNAUTHORIZED=false  # encrypt only — fallback if host uses non-RDS CA
# POSTGRES_SSL_CA_PATH=certs/rds-global-bundle.pem
# POSTGRES_SSL_MODE=disable               # local dev without TLS

# Comma-separated browser origins (required in production)
# CORS_ORIGINS=http://localhost:3000,https://servease-innovation.netlify.app
CORS_ORIGINS=

# Auth0 JWT for mutating APIs (enabled in production when both are set)
# AUTH0_DOMAIN=your-tenant.us.auth0.com
# AUTH0_AUDIENCE=https://your-api-audience
# JWT_PROTECT_MUTATIONS=true
